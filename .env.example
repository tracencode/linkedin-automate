# LinkedIn app (https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3456/callback

# Filled automatically by `npm run auth`. You can also paste values here for GitHub Actions.
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_REFRESH_TOKEN=
# LINKEDIN_PERSON_URN=

# Optional: use rest Posts API if your app has Marketing/Community Management access.
# Default `ugc` works with the self-serve "Share on LinkedIn" product.
LINKEDIN_POST_API=ugc
LINKEDIN_API_VERSION=202509

# OpenAI-compatible API for drafts. Leave empty to post only from content/queue.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_BASE_URL=https://api.openai.com/v1

# 0–1. Auto mode attaches an image this often (higher for how-to posts, lower for questions).
IMAGE_CHANCE=0.4

# Schedule: daily | weekdays | 3x (Tue/Wed/Thu peak) | weekly
SCHEDULE=3x
POST_HOUR=9
POST_MINUTE=15
POST_WEEKDAY=tuesday
TIMEZONE=Asia/Kolkata

# Keep this many approved posts ready to publish.
QUEUE_MIN=5

# Runtime data (queue, history, tokens, images). On Render this is the persistent disk.
# STORE_DIR=/var/data

# Password for the hosted Desk UI. Leave empty for local use.
# UI_PASSWORD=

# On Render, leave false so only GitHub Actions publishes (avoids duplicate posts).
# Local `npm run ui` defaults to true.
# SCHEDULER_ENABLED=true

# If the queue is empty, generate a post and publish it.
AUTO_PUBLISH=false
